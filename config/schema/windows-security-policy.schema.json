{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FluxForge Windows Security Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "settings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "profiles", "value"],
        "properties": {
          "name": {
            "const": "FirewallProfile.Enabled"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["Domain", "Private", "Public"]
            }
          },
          "value": {
            "const": true
          }
        }
      }
    }
  }
}
