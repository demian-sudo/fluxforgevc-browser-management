{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fluxforgevc.com/schemas/policy-1.0.json",
  "title": "FluxForgeVC policy document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policies"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/policy"
      }
    }
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "plan", "destructiveConfirmationRequired"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "destructiveConfirmationRequired": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "provider",
        "platform",
        "securityObjective",
        "severity",
        "desiredState",
        "enforcementMode",
        "prerequisites",
        "requiredPermissions",
        "licensingRequirements",
        "capabilityRequirements",
        "settings",
        "exclusions",
        "dependencies",
        "conflicts",
        "deploymentRing",
        "validationSteps",
        "verificationSteps",
        "owner",
        "reviewDate",
        "illustrative"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$"
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "provider": {
          "enum": [
            "windows",
            "microsoft-intune",
            "google-workspace",
            "chrome-enterprise",
            "android-enterprise",
            "vpn",
            "dns",
            "network-security"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "securityObjective": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low", "informational"]
        },
        "desiredState": {
          "type": "object"
        },
        "enforcementMode": {
          "enum": ["monitor", "recommend", "enforce"]
        },
        "prerequisites": {
          "$ref": "#/definitions/stringList"
        },
        "requiredPermissions": {
          "$ref": "#/definitions/stringList"
        },
        "licensingRequirements": {
          "$ref": "#/definitions/stringList"
        },
        "capabilityRequirements": {
          "$ref": "#/definitions/stringList"
        },
        "settings": {
          "type": "object"
        },
        "exclusions": {
          "$ref": "#/definitions/stringList"
        },
        "dependencies": {
          "$ref": "#/definitions/stringList"
        },
        "conflicts": {
          "$ref": "#/definitions/stringList"
        },
        "deploymentRing": {
          "enum": ["none", "lab", "pilot", "broad"]
        },
        "validationSteps": {
          "$ref": "#/definitions/stringList"
        },
        "verificationSteps": {
          "$ref": "#/definitions/stringList"
        },
        "rollback": {
          "$ref": "#/definitions/rollback"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "reviewDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "illustrative": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "const": "enforce"
              }
            },
            "required": ["enforcementMode"]
          },
          "then": {
            "required": ["rollback"],
            "properties": {
              "rollback": {
                "properties": {
                  "required": {
                    "const": true
                  },
                  "destructiveConfirmationRequired": {
                    "const": true
                  },
                  "plan": {
                    "pattern": ".*\\S.*"
                  }
                },
                "required": ["required", "plan", "destructiveConfirmationRequired"]
              }
            }
          }
        }
      ]
    }
  }
}
